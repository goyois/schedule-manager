# 앱 서버 EC2의 /home/ec2-user/schedule-manager.env로 이 파일을 참고해 실제 값을 채워 만든다.
# 이 파일(app.env.example) 자체는 예시일 뿐이며, 실제 값이 채워진 schedule-manager.env는
# 절대 이 저장소에 커밋하지 않는다 - DEPLOYMENT.md "운영 비밀값 준비" 절 참고
# (SSM Parameter Store에서 받아와 EC2 로컬 파일로만 존재해야 한다).

# --- RDS PostgreSQL ---
DB_HOST=schedule-manager-db.xxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=api
DB_USERNAME=schedule_manager_app
DB_PASSWORD=

# --- ElastiCache Redis ---
REDIS_HOST=schedule-manager-redis.xxxxxx.ng.0001.apn2.cache.amazonaws.com
REDIS_PORT=6379

# --- Anthropic / OpenAI (AI 챗봇, 만다라트/일정 RAG 임베딩) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
